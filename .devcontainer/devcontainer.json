{
  "name": "MicroCorp AI Autonomous Enterprise (Codespace)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8585],
  "portsAttributes": {
    "8585": {
      "label": "MicroCorp Enterprise Console",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postStartCommand": "nohup python3 app.py --host 0.0.0.0 --port 8585 > /tmp/microcorp.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
